<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="terminal_arrow_db" />
        <exclude domain="file" path="keys/" />
        <exclude domain="sharedpref" path="terminal_arrow_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="terminal_arrow_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
